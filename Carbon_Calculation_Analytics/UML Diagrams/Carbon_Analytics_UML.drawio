        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nclassDiagram\n    direction TB\n\n    class ConsumptionRecord {\n        -record_id\n        -building_id\n        -timestamp\n        -electricity_kwh\n        +get_record_id()\n        +get_electricity_kwh()\n    }\n\n    class EmissionFactor {\n        -factor_id\n        -region\n        -year\n        -kgco2e_per_kwh\n        -source\n        +initialize()\n        +validate_factor()\n    }\n\n    class BaseCalculator {\n        -precision\n        +initialize()\n        +calculate()\n    }\n\n    class CarbonCalculator {\n        -calculation_count\n        +calculate()\n        +calculate_total()\n        +convert_to_tonnes()\n    }\n\n    class EmissionResult {\n        -record_id\n        -building_id\n        -factor_id\n        -kgco2e\n        +initialize()\n        +to_dict()\n    }\n\n    class AnalyticsService {\n        -results\n        +aggregate_monthly()\n        +compare_periods()\n        +prepare_chart_data()\n        +export_results_csv()\n    }\n\n    BaseCalculator &lt;|-- CarbonCalculator\n    CarbonCalculator ..&gt; ConsumptionRecord : reads\n    CarbonCalculator ..&gt; EmissionFactor : uses\n    CarbonCalculator --&gt; EmissionResult : creates\n    AnalyticsService ..&gt; EmissionResult : analyzes\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="WLwHCmmCnTaY19sGpWY9-155">
