        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection LR\n\nclass BaseCalculator {\n    -_precision: int\n    +get_precision()\n    +set_precision(value)\n    +calculate(record, factor)\n}\n\nclass CarbonCalculator {\n    -_calculation_count: int\n    +calculate(record, factor)\n    +calculate_total(results)\n    +convert_to_tonnes(kgco2e)\n    +rounded_for_display(kgco2e)\n}\n\nclass EmissionFactor {\n    -_factor_id: int\n    -_region: str\n    -_year: int\n    -_kgco2e_per_kwh: float\n    -_source: str\n    +validate_factor()\n    +to_dict()\n}\n\nclass EmissionResult {\n    -_result_id: int\n    -_record_id: int\n    -_building_id: int\n    -_timestamp: datetime\n    -_electricity_kwh: float\n    -_factor_id: int\n    -_kgco2e: float\n    +to_dict()\n}\n\nclass AnalyticsService {\n    -_results: list\n    +emission_factor: float\n    +add_result(result)\n    +calculate_total()\n    +aggregate_monthly()\n    +aggregate_by_building()\n    +compare_periods(previous, current)\n    +prepare_chart_data()\n    +summary()\n    +export_results_csv()\n    +summarize(records, building_id)\n}\n\nclass CarbonProcessor {\n    +process(record)\n}\n\nclass ScopeFilter {\n    +allowed_scopes: set\n    +process(record)\n    +filter_stream(records)\n}\n\nclass EmissionTransformer {\n    +factors: dict\n    +process(record)\n}\n\nclass Validation {\n    +valid_id(value, name, allow_none)\n    +valid_quantity(value, name)\n    +valid_timestamp(value)\n}\n\nclass ScopeUtilities {\n    +parse_scope(value)\n}\n\nclass AnalyticsAPI {\n    +get_analytics()\n    +handle_analytics_error(error)\n}\n\nclass AnalyticsError {\n    +status_code: int\n}\n\nclass ConsumptionRecord {\n    -record_id: int\n    -building_id: int\n    -timestamp: datetime\n    -electricity_kwh: float\n    +get_record_id()\n    +get_building_id()\n    +get_timestamp()\n    +get_electricity_kwh()\n}\n\nclass ConsumptionRecordsDB {\n    +record_id: int\n    +building_id: int\n    +timestamp: date\n    +electricity_kwh: float\n}\n\nBaseCalculator &lt;|-- CarbonCalculator\nCarbonProcessor &lt;|-- ScopeFilter\nCarbonProcessor &lt;|-- EmissionTransformer\n\nCarbonCalculator ..&gt; ConsumptionRecord : reads\nCarbonCalculator ..&gt; EmissionFactor : uses\nCarbonCalculator ..&gt; EmissionResult : creates\n\nAnalyticsService \&quot;1\&quot; o-- \&quot;0..*\&quot; EmissionResult : aggregates\n\nCarbonCalculator ..&gt; Validation : validates\nEmissionFactor ..&gt; Validation : validates\nEmissionResult ..&gt; Validation : validates\nAnalyticsService ..&gt; Validation : validates\n\nScopeFilter ..&gt; ScopeUtilities : uses\nEmissionTransformer ..&gt; ScopeUtilities : uses\n\nAnalyticsAPI ..&gt; ConsumptionRecordsDB : queries\nAnalyticsAPI ..&gt; AnalyticsService : calls\nAnalyticsAPI ..&gt; AnalyticsError : handles\nAnalyticsService ..&gt; AnalyticsError : raises&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="L-L-Vp7ISU_5mAAqEcu--117">
